# Copy to .env and adjust. Never commit real credentials.
FANTASY_GM_ENVIRONMENT=development
# PostgreSQL in production, e.g. postgresql+psycopg://fantasy_gm:CHANGE_ME@localhost:5432/fantasy_gm
FANTASY_GM_DATABASE_URL=sqlite:///./fantasy_gm.sqlite3
FANTASY_GM_LOG_LEVEL=INFO
# Global kill switch: when false, no decision is ever executed against a provider,
# regardless of any league's autonomy policy.
FANTASY_GM_EXECUTION_ENABLED=false
